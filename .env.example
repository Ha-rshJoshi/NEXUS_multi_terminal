# Copy this file to .env and fill in real values before running
# docker-compose up --build (or `python app.py` locally).
# .env itself is gitignored -- never commit real secrets.

# Required for /api/chat (Gemini RAG responses) and evaluation.py's AI summary
GEMINI_API_KEY=
# Optional automatic fallback if Gemini's free-tier quota is exhausted
GROQ_API_KEY=

# Required for live price streaming + company news (data_engine.py, news_scraper.py)
FINNHUB_API_KEY=

# Defaults to a local SQLite file if unset. Set to a Postgres URL when
# running via docker-compose (already wired in docker-compose.yml).
DATABASE_URL=sqlite:///nexus.db

# Postgres credentials for docker-compose (postgres_db/web_app/pipeline_worker
# all read these instead of docker-compose.yml hardcoding them in plain text).
# Pick your own values -- these are only placeholders.
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=change_me_to_a_real_password
POSTGRES_DB=quant_metrics
